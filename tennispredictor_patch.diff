   workflow_dispatch: # Permet de lancer manuellement depuis l'interface GitHub
 
+# Empêche deux runs de tourner en même temps (cron + déclenchement manuel) :
+# sans ça, deux runs concurrents peuvent se marcher dessus sur la
+# suppression/recréation de la release "latest_model" (gh release delete /
+# gh release create) et faire échouer l'étape d'upload.
+concurrency:
+  group: model-update
+  cancel-in-progress: true
+
