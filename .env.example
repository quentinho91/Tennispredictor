# Clés API (optionnelles pour les fonctionnalités étendues)
GROQ_API_KEY=votre_cle_groq_ici
TAVILY_API_KEY=votre_cle_tavily_ici

# Modèle Groq optionnel (par défaut: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# Alertes Quotidiennes Telegram (Scan TennisExplorer & Value Bets)
# 1. Créer un bot via @BotFather sur Telegram -> copier le token
# 2. Obtenir votre chat_id via @userinfobot sur Telegram -> copier l'id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

